{
  "kind": "collectionType",
  "collectionName": "fea_videos",
  "info": {
    "singularName": "fea-video",
    "pluralName": "fea-videos",
    "displayName": "Fea Video",
    "description": "Featured videos for homepage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Rank": {
      "type": "integer",
      "default": 0
    },
    "video": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::video.video"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
